--- a/libavformat/hls.c
+++ b/libavformat/hls.c
@@ -665,6 +665,14 @@
     if (!proto_name)
         proto_name = avio_find_protocol_name(url);
 
+#ifdef __EMSCRIPTEN__
+    // Browser custom AVIO has no native HTTP URLProtocol. Transport policy is
+    // enforced by the host's bounded loader, including every nested resource.
+    if (!proto_name && (s->flags & AVFMT_FLAG_CUSTOM_IO)) {
+        if (av_strstart(url, "https://", NULL)) proto_name = "https";
+        else if (av_strstart(url, "http://", NULL)) proto_name = "http";
+    }
+#endif
     if (!proto_name)
         return AVERROR_INVALIDDATA;
 
