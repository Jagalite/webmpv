Backport the MOV fragment/index reset from FFmpeg n8.0 mov_read_packet.
Source: https://raw.githubusercontent.com/FFmpeg/FFmpeg/n8.0/libavformat/mov.c
Source SHA-256: d3af210b765416a9c1a6aceadbabe51a233a18a26fa8c3071b8b1c8307a3935a
Rationale: HLS resets AVIO position on seek, but n7.1.1 retains stale fMP4
sample offsets and returns corrupt NAL units. Upstream report and patch series:
https://ffmpeg.org/pipermail/ffmpeg-devel/2024-November/335634.html

Adaptation: n7.1.1 uses ctts_index/ctts_sample rather than n8.0 tts_index.

--- a/libavformat/mov.c
+++ b/libavformat/mov.c
@@ -10473,15 +10473,15 @@
 
     if (index >= 0 && index < mov->frag_index.nb_items)
         target = mov->frag_index.item[index].moof_offset;
-    if (avio_seek(s->pb, target, SEEK_SET) != target) {
+    if (target >= 0 && avio_seek(s->pb, target, SEEK_SET) != target) {
         av_log(mov->fc, AV_LOG_ERROR, "root atom offset 0x%"PRIx64": partial file\n", target);
         return AVERROR_INVALIDDATA;
     }
 
     mov->next_root_atom = 0;
-    if (index < 0 || index >= mov->frag_index.nb_items)
+    if ((index < 0 && target >= 0) || index >= mov->frag_index.nb_items)
