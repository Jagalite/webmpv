+// Some FFmpeg encoders omit NUT keyframe flags. Recover only contracts that
+// can be verified: DFPWM's headerless audio and self-contained Dirac intra units.
+static int dirac_intra_packet(const uint8_t *data, int size)
+{
+    int sequence = 0;
+    for (int at = 0; at <= size - 13;) {
+        if (AV_RB32(data + at) != 0x42424344)
+            return 0;
+        int code = data[at + 4];
+        unsigned next = AV_RB32(data + at + 5);
+        if (code == 0)
+            sequence = 1;
+        if (code & 8)
+            return sequence && !(code & 3);
+        if (next < 13 || next > size - at)
+            return 0;
+        at += next;
+    }
+    return 0;
+}
