+execFileSync('tar',['-czf',out+'/inputs.tgz','experiments/pipeline-qualification',...engines,'build/pipeline-qualification/remux/remux.mjs','build/pipeline-qualification/yuv/player.mjs','build/pipeline-qualification/yuv/worker.js']);
